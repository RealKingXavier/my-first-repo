# Copy to .env.local for local development. In production set these in
# Netlify → Site configuration → Environment variables. Never commit real values.

# Admin area (/admin). Leave unset to disable it entirely (404).
ADMIN_USER=admin
ADMIN_PASSWORD=          # at least 12 characters

# Salt for hashing IP addresses used by the form rate limiter.
RATE_LIMIT_SALT=

# Email notifications — choose ONE option.
# Option A: Netlify Forms relay (no extra account). Then add an email
# notification in Netlify → Forms → Form notifications.
NETLIFY_FORMS_RELAY=true
# Option B: Resend (https://resend.com) with a verified sending domain.
RESEND_API_KEY=
NOTIFY_FROM="Bahia Dreams <inquiries@bahiadreamscr.com>"
NOTIFY_TO=bahiadreamscostarica@gmail.com

# Privacy-friendly analytics (optional). Set to the domain registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
